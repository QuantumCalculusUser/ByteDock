# Backend-only secrets. Never put these in VITE_* variables or frontend source.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=

# Remote execution provider. Use a managed/private Judge0 deployment for production.
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_AUTH_TOKEN=
JUDGE0_PYTHON_LANGUAGE_ID=71
JUDGE0_JAVASCRIPT_LANGUAGE_ID=63

# Exact deployed frontend origin, e.g. https://USERNAME.github.io
CORS_ORIGIN=
PORT=4173
