# Local development only. Never commit the real .env file.
PORT=4173
NODE_ENV=development
AUTH_REQUIRED=false

# Nebius Token Factory (server-side only)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=

# Supabase account authentication + per-user workspace storage.
# Leave blank for local-only filesystem mode. Public Render deployment requires all 3.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Remote execution. Local dev can use the public CE endpoint for smoke testing.
# For production, use a managed/private Judge0 deployment and explicitly enable it.
EXECUTION_ENABLED=false
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_AUTH_TOKEN=
JUDGE0_PYTHON_LANGUAGE_ID=71
JUDGE0_JAVASCRIPT_LANGUAGE_ID=63

# Backend CORS allowlist. Use the origin only, no repository path.
CORS_ORIGIN=http://localhost:4173

# VITE_API_BASE_URL is a PUBLIC frontend build-time variable, set in GitHub Actions.
